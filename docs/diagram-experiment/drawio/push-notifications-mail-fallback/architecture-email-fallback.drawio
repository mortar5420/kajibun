<mxfile host="app.diagrams.net">
  <diagram id="architecture" name="architecture"><mxGraphModel dx="1700" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Push通知機能 全体システム構成（メールフォールバック追加）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="980" height="50" as="geometry"/></mxCell><mxCell id="terminal" value="ユーザー端末 / ブラウザ・PWA" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#eaf3ff;strokeColor=#6c8ebf;fontSize=16;fontStyle=1;startSize=34;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="430" height="610" as="geometry"/></mxCell><mxCell id="pwa" value="&lt;b&gt;React PWA&lt;/b&gt;&lt;br&gt;家事完了操作&lt;br&gt;通知設定UI&lt;br&gt;Service Worker登録&lt;br&gt;Subscription作成・同期&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;利用: Notifications API / Push API / PushManager&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="350" height="190" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b&gt;push-sw.js&lt;/b&gt;&lt;br&gt;pushイベント受信&lt;br&gt;showNotification()&lt;br&gt;通知クリック時のfocus / openWindow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="80" y="480" width="350" height="150" as="geometry"/></mxCell><mxCell id="user" value="ユーザー" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="205" y="80" width="40" height="70" as="geometry"/></mxCell><mxCell id="cloudflare" value="Cloudflare" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=16;fontStyle=1;startSize=34;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="520" height="610" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;Cloudflare Worker&lt;br&gt;kajibun API&lt;/b&gt;&lt;br&gt;Hono API / 認証&lt;br&gt;家事完了・次担当者決定&lt;br&gt;task_events保存&lt;br&gt;notification_jobs作成&lt;br&gt;VAPID JWT生成・payload暗号化&lt;br&gt;Web Push送信&lt;br&gt;Push失敗時のメール通知&lt;br&gt;定期通知・pending再送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="600" y="190" width="430" height="290" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Cloudflare D1&lt;/b&gt;&lt;br&gt;users.email&lt;br&gt;tasks&lt;br&gt;task_events&lt;br&gt;push_subscriptions&lt;br&gt;notification_jobs" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="540" width="200" height="135" as="geometry"/></mxCell><mxCell id="cron" value="&lt;b&gt;Cloudflare Cron Trigger&lt;/b&gt;&lt;br&gt;0 3,9 * * *&lt;br&gt;期限通知作成&lt;br&gt;pending通知再送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="555" width="185" height="105" as="geometry"/></mxCell><mxCell id="push" value="&lt;b&gt;外部Push Service&lt;/b&gt;&lt;br&gt;Subscription endpoint&lt;br&gt;ブラウザベンダーのPush配送基盤&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;特定事業者名は実装上固定されない&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="190" width="330" height="145" as="geometry"/></mxCell><mxCell id="email" value="&lt;b&gt;外部メール送信サービス&lt;/b&gt;&lt;br&gt;Push失敗時のフォールバック配送&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;特定事業者名は固定しない&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="430" width="330" height="115" as="geometry"/></mxCell><mxCell id="mailbox" value="&lt;b&gt;ユーザーBのメールボックス&lt;/b&gt;&lt;br&gt;家事完了通知メール" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="610" width="330" height="85" as="geometry"/></mxCell><mxCell id="os" value="&lt;b&gt;ブラウザ / OS&lt;/b&gt;&lt;br&gt;通知表示&lt;br&gt;通知クリック" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1180" y="780" width="330" height="105" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;図の粒度&lt;/b&gt;&lt;br&gt;Tasks API / Task Service / Event Dispatcher / Notification Service / Web Push Adapter / Scheduled Handler / メール通知処理は同一Worker内の実装として統合。&lt;br&gt;Push送信失敗時、または有効なSubscriptionがない場合、D1のusers.emailを使ってユーザーBへメール通知する。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1040" height="110" as="geometry"/></mxCell><mxCell id="e1" value="操作" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="user" target="pwa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="HTTPS API&lt;br&gt;GET /api/push/vapid-public-key&lt;br&gt;POST /api/push-subscriptions&lt;br&gt;PATCH /api/tasks/:taskId/complete&lt;br&gt;POST /api/push/test" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pwa" target="worker"><mxGeometry relative="1" as="geometry"><mxPoint x="515" y="290" as="targetPoint"/></mxGeometry></mxCell><mxCell id="e3" value="/push-sw.js 登録" style="endArrow=block;html=1;rounded=0;strokeColor=#6c8ebf;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="pwa" target="sw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="SQL&lt;br&gt;家事・イベント・購読・通知ジョブ・users.email" style="endArrow=block;startArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="worker" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="scheduled handler起動" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="cron" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="暗号化payloadをPOST&lt;br&gt;Authorization: vapid&lt;br&gt;Content-Encoding: aes128gcm&lt;br&gt;TTL: 60" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="worker" target="push"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eEmail1" value="Push送信失敗時&lt;br&gt;users.email宛てにメール送信" style="endArrow=block;html=1;rounded=0;strokeColor=#2d7600;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="worker" target="email"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eEmail2" value="家事完了通知メールを配送" style="endArrow=block;html=1;rounded=0;strokeColor=#2d7600;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="email" target="mailbox"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Push message配送" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="push" target="sw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1345" y="375"/><mxPoint x="255" y="375"/></Array></mxGeometry></mxCell><mxCell id="e8" value="showNotification()" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="sw" target="os"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="750"/><mxPoint x="1345" y="750"/></Array></mxGeometry></mxCell><mxCell id="e9" value="通知クリック" style="endArrow=block;html=1;rounded=0;strokeColor=#9673a6;fontSize=12;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="os" target="sw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1345" y="920"/><mxPoint x="400" y="920"/></Array></mxGeometry></mxCell><mxCell id="e10" value="既存画面focus&lt;br&gt;または / をopenWindow" style="endArrow=block;html=1;rounded=0;strokeColor=#9673a6;fontSize=12;edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" parent="1" source="sw" target="pwa"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
