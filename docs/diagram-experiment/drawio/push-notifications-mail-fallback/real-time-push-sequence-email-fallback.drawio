x="1" parent="1"><mxGeometry x="1350" y="100" width="190" height="50" as="geometry"/></mxCell><mxCell id="pa7" value="ユーザーBの&lt;br&gt;push-sw.js" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1595" y="100" width="170" height="50" as="geometry"/></mxCell><mxCell id="pa8" value="ユーザーB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1790" y="100" width="100" height="50" as="geometry"/></mxCell><mxCell id="l1" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="150" as="sourcePoint"/><mxPoint x="100" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="150" as="sourcePoint"/><mxPoint x="305" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="150" as="sourcePoint"/><mxPoint x="620" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="150" as="sourcePoint"/><mxPoint x="925" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="150" as="sourcePoint"/><mxPoint x="1195" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l6" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="150" as="sourcePoint"/><mxPoint x="1445" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l7" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1680" y="150" as="sourcePoint"/><mxPoint x="1680" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="l8" value="" style="endArrow=none;dashed=1;html=1;rounded=0;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1840" y="150" as="sourcePoint"/><mxPoint x="1840" y="1820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note0" value="前提: ユーザーBは通知を有効化済みの場合、Push Subscription がD1に保存済み" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="1470" y="170" width="360" height="70" as="geometry"/></mxCell><mxCell id="actWorker" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d79b00;opacity=35;" vertex="1" parent="1"><mxGeometry x="610" y="260" width="20" height="1350" as="geometry"/></mxCell><mxCell id="m1" value="1. 自分の担当家事で「終わった」を押す" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="100" y="260" as="sourcePoint"/><mxPoint x="305" y="260" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2" value="2. PATCH /api/tasks/:taskId/complete&lt;br&gt;Cookie付き" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="320" as="sourcePoint"/><mxPoint x="620" y="320" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m3" value="3. セッションCookieからユーザーAを認証" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="380" as="sourcePoint"/><mxPoint x="925" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r3" value="ユーザーA" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="410" as="sourcePoint"/><mxPoint x="620" y="410" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="4. 対象家事を取得" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="470" as="sourcePoint"/><mxPoint x="925" y="470" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r4" value="家事" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="500" as="sourcePoint"/><mxPoint x="620" y="500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note1" value="ユーザーA以外の許可ユーザーを次担当者として決定し、繰り返し間隔から次回期限を計算" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="525" width="330" height="70" as="geometry"/></mxCell><mxCell id="m5" value="5. tasksを更新&lt;br&gt;次回期限・次担当者" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="630" as="sourcePoint"/><mxPoint x="925" y="630" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r5" value="更新完了" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="660" as="sourcePoint"/><mxPoint x="620" y="660" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="6. task_eventsへTaskCompletedを保存" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="720" as="sourcePoint"/><mxPoint x="925" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r6" value="eventId付きTaskCompleted" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="750" as="sourcePoint"/><mxPoint x="620" y="750" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note2" value="通知先: TaskCompleted.payload.toAssigneeUserId&lt;br&gt;つまり完了後の次担当者 = ユーザーB" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="470" y="780" width="330" height="70" as="geometry"/></mxCell><mxCell id="m7" value="7. notification_jobsを作成&lt;br&gt;type=task_completed&lt;br&gt;dedupe_key=task_completed:eventId:recipientUserId" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="880" as="sourcePoint"/><mxPoint x="925" y="880" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r7" value="pendingジョブ" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="920" as="sourcePoint"/><mxPoint x="620" y="920" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="8. ユーザーBの有効なpush_subscriptionsを取得" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="970" as="sourcePoint"/><mxPoint x="925" y="970" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r8" value="endpoint / p256dh / auth" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1000" as="sourcePoint"/><mxPoint x="620" y="1000" as="targetPoint"/></mxGeometry></mxCell><mxCell id="altSuccess" value="有効なSubscriptionがありPush送信が成功" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#666666;fontSize=12;fontStyle=1;startSize=24;dashed=1;" vertex="1" parent="1"><mxGeometry x="455" y="1030" width="1370" height="230" as="geometry"/></mxCell><mxCell id="note3" value="同じ家事完了APIリクエスト内でVAPID JWT生成とpayload暗号化を行う" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="485" y="1065" width="300" height="55" as="geometry"/></mxCell><mxCell id="m9" value="9. Subscription endpointへPOST&lt;br&gt;暗号化payload / Authorization: vapid / aes128gcm" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1140" as="sourcePoint"/><mxPoint x="1195" y="1140" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r9" value="成功" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1170" as="sourcePoint"/><mxPoint x="620" y="1170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="10. notification_jobsをsentへ更新" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1210" as="sourcePoint"/><mxPoint x="925" y="1210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="11. Push messageを配送" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1240" as="sourcePoint"/><mxPoint x="1680" y="1240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m12" value="12. pushイベントでpayloadを読み取り showNotification()" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1680" y="1275" as="sourcePoint"/><mxPoint x="1840" y="1275" as="targetPoint"/></mxGeometry></mxCell><mxCell id="altFail" value="有効なSubscriptionがあるがPush送信が失敗" style="swimlane;html=1;rounded=0;whiteSpace=wrap;fillColor=none;strokeColor=#82b366;fontSize=12;fontStyle=1;startSize=24;dashed=1;" vertex="1" parent="1"><mxGeometry x="455" y="1320" width="1120" height="290" as="geometry"/></mxCell><mxCell id="m13" value="13. Subscription endpointへPOST" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1370" as="sourcePoint"/><mxPoint x="1195" y="1370" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r13" value="失敗" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1400" as="sourcePoint"/><mxPoint x="620" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m14" value="14. notification_jobsをpendingまたはfailedへ更新&lt;br&gt;404・410ではSubscriptionをrevokedにする場合あり" style="endArrow=block;html=1;rounded=0;strokeColor=#333333;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1445" as="sourcePoint"/><mxPoint x="925" y="1445" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m15" value="15. ユーザーBのemailを取得" style="endArrow=block;html=1;rounded=0;strokeColor=#2d7600;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1500" as="sourcePoint"/><mxPoint x="925" y="1500" as="targetPoint"/></mxGeometry></mxCell><mxCell id="r15" value="users.email" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#2d7600;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="925" y="1530" as="sourcePoint"/><mxPoint x="620" y="1530" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m16" value="16. 家事完了通知メールを送信" style="endArrow=block;html=1;rounded=0;strokeColor=#2d7600;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1575" as="sourcePoint"/><mxPoint x="1445" y="1575" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m17" value="17. メールで通知" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#2d7600;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1445" y="1605" as="sourcePoint"/><mxPoint x="1840" y="1605" as="targetPoint"/></mxGeometry></mxCell><mxCell id="elseNoSub" value="有効なSubscriptionがない場合: notification_jobsをfailedへ更新 last_error=no_active_push_subscription。その後、ユーザーBのusers.emailを取得して外部メール送信サービスから家事完了通知メールを送信。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;fontSize=12;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="455" y="1640" width="870" height="70" as="geometry"/></mxCell><mxCell id="note4" value="補足: 再試行可能なPush失敗はpendingで残り、後続のCron実行で再送される。メール送信サービスの具体的な事業者名は固定しない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="1630" width="370" height="80" as="geometry"/></mxCell><mxCell id="m18" value="18. 更新後の家事を返す" style="endArrow=block;dashed=1;html=1;rounded=0;strokeColor=#666666;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="1760" as="sourcePoint"/><mxPoint x="305" y="1760" as="targetPoint"/></mxGeometry></mxCell><mxCell id="opt1" value="任意: ユーザーBがPush通知をクリックすると、既存のkajibun画面をfocus。なければ / をopenWindow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;dashed=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="1730" width="330" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram>
